{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run dev server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "jinja": true,
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on http://[^:]+:(\\d+)",
        "uriFormat": "http://192.168.1.116:%s",
        "action": "openExternally"
      }
    }
  ]
}
